# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Required: Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Base URL for PDF generation (set in production)
# BASE_URL=https://your-app.onrender.com

# Required: Flask secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Optional: Redis URL (defaults to localhost:6379)
# REDIS_URL=redis://localhost:6379/0

# Optional: Rate limiting (requests per minute)
# RATE_LIMIT_DEFAULT=60

# Optional: Enable debug mode (never enable in production!)
# FLASK_DEBUG=false

# Optional: CORS origins (comma-separated)
# CORS_ORIGINS=https://your-domain.com